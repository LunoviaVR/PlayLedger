<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything in the dashboard that isn't UI: the tracker protocol, the pipe client and formatting.
       Plain .NET so it builds and is tested on any OS; the WinUI app only presents it. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>PlaytimeTracker.Dashboard.Core</RootNamespace>
    <Version>2.2.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PlaytimeTracker.Dashboard.Tests" />
  </ItemGroup>

</Project>
