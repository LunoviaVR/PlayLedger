<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end check of the installed tracker on a real Windows machine (CI): pipe, tracking, protected storage,
       restart, and screenshots of the dashboard's pages. Run by the Build workflow's preview job. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaytimeTracker.Dashboard.Core\PlaytimeTracker.Dashboard.Core.csproj" />
  </ItemGroup>

</Project>
