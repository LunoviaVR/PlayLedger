<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlaytimeTracker.Dashboard.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PlaytimeTracker.Dashboard.Pages">

    <Page.Resources>
        <!-- A removable entry in one of the settings lists. -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="local:ListEntry">
            <Grid ColumnSpacing="12" Padding="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind DetailVisibility}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Remove" Tag="{x:Bind}" Click="RemoveEntry_Click"
                        AutomationProperties.Name="{x:Bind RemoveName}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- A ContentControl so the whole page can be disabled until the settings have loaded. -->
        <ContentControl x:Name="Body" IsEnabled="False" HorizontalContentAlignment="Stretch" IsTabStop="False">
        <StackPanel Padding="24,16,24,32" HorizontalAlignment="Stretch" Spacing="4">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <!-- Appearance -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Theme" />
                        <TextBlock Text="Follow Windows, or always use light or dark." Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                    <ComboBox x:Name="Theme" Grid.Column="1" MinWidth="160" SelectionChanged="Theme_SelectionChanged"
                              AutomationProperties.Name="Theme">
                        <x:String>Use Windows setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Accent colour" />
                            <TextBlock Text="Used for charts, selection and buttons." Style="{StaticResource CaptionStyle}" />
                        </StackPanel>
                        <ComboBox x:Name="AccentChoice" Grid.Column="1" MinWidth="160" SelectionChanged="Accent_SelectionChanged"
                                  AutomationProperties.Name="Accent colour" />
                    </Grid>
                    <StackPanel x:Name="CustomAccentPanel" Visibility="Collapsed" Spacing="8">
                        <ColorPicker x:Name="CustomAccent" IsAlphaEnabled="False" IsMoreButtonVisible="True"
                                     IsColorChannelTextInputVisible="True" IsHexInputVisible="True"
                                     AutomationProperties.Name="Custom accent colour" />
                        <Button Content="Use this colour" Click="ApplyCustomAccent_Click" Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Startup -->
            <TextBlock Text="Startup" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <ToggleSwitch x:Name="StartWithWindows" Header="Start Playtime Tracker when I sign in to Windows" Toggled="StartWithWindows_Toggled" />
                    <TextBlock x:Name="StartupNote" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- General -->
            <TextBlock Text="General" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="Notifications" Header="Notify me when a session is logged" Toggled="Toggle_Changed" />
                    <ToggleSwitch x:Name="WindowsGameList" Header="Also count programs Windows (Xbox Game Bar) recognises as games" Toggled="Toggle_Changed" />
                </StackPanel>
            </Border>

            <!-- Tracking -->
            <TextBlock Text="Tracking" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <NumberBox x:Name="PollInterval" Header="Check for running games every (seconds)" Minimum="1" Maximum="300"
                               SpinButtonPlacementMode="Inline" SmallChange="1" ValueChanged="Number_Changed" MaxWidth="360" HorizontalAlignment="Left" />
                    <NumberBox x:Name="MinimumSession" Header="Skip sessions shorter than (seconds, 0 keeps every session)" Minimum="0" Maximum="3600"
                               SpinButtonPlacementMode="Inline" SmallChange="10" ValueChanged="Number_Changed" MaxWidth="360" HorizontalAlignment="Left" />
                    <NumberBox x:Name="GracePeriod" Header="A game closed and reopened within this many seconds stays one session" Minimum="0" Maximum="600"
                               SpinButtonPlacementMode="Inline" SmallChange="5" ValueChanged="Number_Changed" MaxWidth="360" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <!-- Artwork -->
            <TextBlock Text="Artwork" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Box art comes from Steam's own image cache and each game's icon, without going online." />
                    <ToggleSwitch x:Name="OnlineArtwork" Header="Download missing artwork" Toggled="Toggle_Changed" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="When on, Steam games' pictures are fetched from the Steam store using only the game's Steam ID. Your play history is never sent." />
                    <StackPanel Spacing="8">
                        <TextBlock Text="SteamGridDB API key (optional)" />
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                                   Text="With your own free key from steamgriddb.com, artwork is also found for games outside Steam (by the game's name). The key is kept in Windows Credential Manager on this PC." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="SteamGridDbKey" Width="320" PlaceholderText="32 letters and digits"
                                         AutomationProperties.Name="SteamGridDB API key" />
                            <Button Content="Save key" Click="SaveKey_Click" />
                            <Button x:Name="RemoveKey" Content="Remove key" Click="RemoveKey_Click" />
                        </StackPanel>
                        <TextBlock x:Name="KeyStatus" Style="{StaticResource CaptionStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Games -->
            <TextBlock Text="Custom games" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Pick a game's .exe to track something Playtime Tracker doesn't find on its own." />
                    <ItemsControl x:Name="CustomGames" ItemTemplate="{StaticResource EntryTemplate}" />
                    <Button Content="Add a game…" Click="AddCustomGame_Click" />
                </StackPanel>
            </Border>

            <TextBlock Text="Game folders" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Folders where every sub-folder is a game, e.g. D:\Games." />
                    <ItemsControl x:Name="Folders" ItemTemplate="{StaticResource EntryTemplate}" />
                    <Button Content="Add a folder…" Click="AddFolder_Click" />
                </StackPanel>
            </Border>

            <TextBlock Text="Ignored games" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <ItemsControl x:Name="IgnoredGames" ItemTemplate="{StaticResource EntryTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewIgnoredGame" Width="320" PlaceholderText="Game or folder name"
                                 AutomationProperties.Name="Game to ignore" />
                        <Button Content="Ignore" Click="AddIgnoredGame_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="Ignored programs" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Launchers, crash reporters and anti-cheat that should never count as playing." />
                    <ItemsControl x:Name="IgnoredPrograms" ItemTemplate="{StaticResource EntryTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NewIgnoredProgram" Width="320" PlaceholderText="e.g. launcher.exe"
                                 AutomationProperties.Name="Program to ignore" />
                        <Button Content="Ignore" Click="AddIgnoredProgram_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates -->
            <TextBlock Text="Updates" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <ToggleSwitch x:Name="CheckUpdates" Header="Check for updates" Toggled="Toggle_Changed" />
                    <ToggleSwitch x:Name="AutoUpdates" Header="Install updates automatically (never while a game is running)" Toggled="Toggle_Changed" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Updates come from this project's GitHub releases and are installed only if their size and checksum match what GitHub recorded." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="CheckNow" Content="Check now" Click="CheckNow_Click" />
                        <Button x:Name="InstallNow" Content="Install update" Click="InstallNow_Click" Visibility="Collapsed"
                                Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Your data -->
            <TextBlock Text="Your data" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"
                               Text="Your play history stays on this PC, protected so it can't be edited by hand." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Rescan installed games" Click="Rescan_Click" />
                        <Button Content="Export sessions…" Click="Export_Click" />
                        <Button Content="Open report" Click="OpenReport_Click"
                                ToolTipService.ToolTip="Game Stats.txt: every game and session as plain text" />
                        <Button Content="Open data folder" Click="OpenFolder_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <TextBlock x:Name="About" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </Border>
        </StackPanel>
        </ContentControl>
    </ScrollViewer>
</Page>
