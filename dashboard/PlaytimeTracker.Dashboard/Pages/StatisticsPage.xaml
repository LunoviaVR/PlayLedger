<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlaytimeTracker.Dashboard.Pages.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlaytimeTracker.Dashboard.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="RankTemplate" x:DataType="vm:RankItem">
            <Grid ColumnSpacing="16" Padding="0,6" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Width="{x:Bind BarWidth}" Height="10" RadiusX="5" RadiusY="5"
                           HorizontalAlignment="Left" VerticalAlignment="Center"
                           Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                <TextBlock Grid.Column="2" Text="{x:Bind ValueText}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{x:Bind PercentText}" Style="{StaticResource CaptionStyle}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24,16,24,32" MaxWidth="1200" HorizontalAlignment="Stretch">
            <TextBlock Text="Statistics" Style="{StaticResource PageTitleStyle}" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Days played (last 30)" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="DaysPlayed" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Average per day played" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="PerDay" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Longest session" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="Longest" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="LongestDetail" Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Games played" Style="{StaticResource CaptionStyle}" />
                        <TextBlock x:Name="GameCount" Text="–" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Most played" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ItemsControl x:Name="TopGames" ItemTemplate="{StaticResource RankTemplate}" AutomationProperties.Name="Most played games" />
            </Border>

            <TextBlock Text="By day of the week" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ItemsControl x:Name="Weekdays" ItemTemplate="{StaticResource RankTemplate}" AutomationProperties.Name="Playtime by day of the week" />
            </Border>

            <TextBlock Text="By time of day" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <ItemsControl x:Name="DayParts" ItemTemplate="{StaticResource RankTemplate}" AutomationProperties.Name="Playtime by time of day" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
