<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PlaytimeTracker.Dashboard.Pages.GamesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PlaytimeTracker.Dashboard.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="GameTemplate" x:DataType="vm:GameItem">
            <StackPanel Width="160" Spacing="6" Margin="4" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid Width="160" Height="240" CornerRadius="8"
                      Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <TextBlock Text="{x:Bind Initial}" Visibility="{x:Bind InitialVisibility, Mode=OneWay}"
                               FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               AutomationProperties.AccessibilityView="Raw" />
                    <Image Source="{x:Bind Cover, Mode=OneWay}" Stretch="{x:Bind CoverStretch, Mode=OneWay}"
                           AutomationProperties.AccessibilityView="Raw" />
                    <Border Visibility="{x:Bind LiveVisibility}" Margin="8" Padding="8,2" CornerRadius="4"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="{ThemeResource SystemFillColorSuccessBrush}">
                        <TextBlock Text="Playing" FontSize="11" Foreground="White" />
                    </Border>
                </Grid>
                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource CaptionStyle}" TextTrimming="CharacterEllipsis">
                    <Run Text="{x:Bind TotalText}" /><Run Text=" · " /><Run Text="{x:Bind Detail}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24,16,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Games" Style="{StaticResource PageTitleStyle}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <AutoSuggestBox x:Name="Search" Width="280" PlaceholderText="Search games" QueryIcon="Find"
                            TextChanged="Search_TextChanged" AutomationProperties.Name="Search games" />
            <ComboBox x:Name="Sort" SelectedIndex="0" SelectionChanged="Sort_SelectionChanged" MinWidth="180"
                      AutomationProperties.Name="Sort games">
                <x:String>Most played</x:String>
                <x:String>Recently played</x:String>
                <x:String>Name</x:String>
            </ComboBox>
        </StackPanel>
        <ScrollViewer Grid.Row="2">
            <StackPanel Padding="0,0,0,32">
                <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                    <TextBlock Text="Playing now" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,8" />
                    <GridView x:Name="LiveGames" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Game_Click"
                              ItemTemplate="{StaticResource GameTemplate}" AutomationProperties.Name="Playing now" />
                </StackPanel>
                <TextBlock Text="Played before" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,8" />
                <GridView x:Name="AllGames" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Game_Click"
                          ItemTemplate="{StaticResource GameTemplate}" AutomationProperties.Name="Played before" />
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap"
                           Text="No games yet. Games you play show up here." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
