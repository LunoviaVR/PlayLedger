<Project Sdk="Microsoft.NET.Sdk">

  <!-- The WinUI 3 dashboard: presentation only. All data and logic come from playtime-tracker.exe over its pipe,
       through PlaytimeTracker.Dashboard.Core. Unpackaged and self-contained, installed next to the tracker. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>PlaytimeTracker.Dashboard</RootNamespace>
    <AssemblyName>PlaytimeTracker.Dashboard</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\src\GameSessionTracker\app.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- Lets the project restore on non-Windows machines (e.g. GitHub's dependency scan); it still builds only on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2.2.0</Version>
    <Product>Playtime Tracker</Product>
    <Description>Playtime Tracker dashboard</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon (AppWindow.SetIcon needs a file). -->
    <Content Include="..\..\src\GameSessionTracker\app.ico" Link="app.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaytimeTracker.Dashboard.Core\PlaytimeTracker.Dashboard.Core.csproj" />
  </ItemGroup>

</Project>
