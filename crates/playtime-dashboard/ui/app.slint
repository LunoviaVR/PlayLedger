// The dashboard window: a Task Manager-style navigation pane on the left and the chosen page on the right.
import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Line, Caption, FluentButton } from "controls.slint";
import { Tile, SessionRow, GameRow, DayBar } from "data.slint";
import { OverviewPage } from "overview.slint";

export { Theme, Palette }
export { Tile, SessionRow, GameRow, DayBar }

component NavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    in property <bool> compact;
    callback clicked;
    height: 40px;
    border-radius: 4px;
    background: selected ? Theme.subtle : touch.has-hover ? Theme.subtle : transparent;
    accessible-role: tab;
    accessible-label: label;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }
    forward-focus: focus;
    // The accent pill Windows 11 draws beside the selected item.
    if selected: Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 16px;
        Text {
            text: root.glyph;
            font-family: Theme.icons;
            font-size: 16px;
            color: Theme.text;
            vertical-alignment: center;
            width: 16px;
            accessible-role: none;
        }
        if !root.compact: Line { text: root.label; vertical-alignment: center; }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") { root.clicked(); return accept; }
            reject
        }
    }
    Rectangle {
        border-radius: 4px;
        border-width: focus.has-focus ? 2px : 0;
        border-color: Theme.text;
    }
}

export component AppWindow inherits Window {
    title: "Playtime Tracker";
    icon: @image-url("app-icon.png");
    preferred-width: 1180px;
    preferred-height: 800px;
    // Below this the layout stops working, as Task Manager also stops shrinking.
    min-width: 500px;
    min-height: 500px;
    background: Theme.window;
    default-font-family: Theme.font;

    // 0 Overview, 1 Games, 2 History, 3 Statistics, 4 Settings.
    in-out property <int> page: 0;
    // The user's choice with the ☰ button; in a narrow window the pane folds to icons anyway, as Task Manager's does.
    in-out property <bool> pane-open: true;
    property <bool> pane-expanded: pane-open && root.width >= 800px;
    // Shown when the tracker can't be reached, with a button to start it.
    in property <string> connection-problem;
    callback navigate(int);
    callback start-tracker();

    // Overview
    in property <string> overview-title: "Overview";
    in property <bool> overview-one-game;
    in property <[Tile]> overview-tiles;
    in property <[SessionRow]> overview-live;
    in property <[DayBar]> overview-bars;
    in property <[GameRow]> overview-games;
    in property <[SessionRow]> overview-sessions;
    in property <string> overview-sessions-header: "Sessions";
    in property <string> overview-show-more-text;
    in property <bool> overview-empty;
    callback overview-all-games();
    callback overview-game(int);
    callback overview-live-session(int);
    callback overview-session(int);
    callback overview-day(int);
    callback overview-show-more();

    HorizontalLayout {
        // Navigation pane (collapses to icons with the ☰ button, as Task Manager's does).
        VerticalLayout {
            width: root.pane-expanded ? 220px : 56px;
            padding: 4px;
            spacing: 2px;
            NavItem {
                glyph: "\u{E700}";
                label: root.pane-expanded ? "Collapse navigation" : "Expand navigation";
                compact: true;
                clicked => { root.pane-open = !root.pane-open; }
            }
            NavItem { glyph: "\u{E80F}"; label: "Overview"; compact: !root.pane-expanded; selected: root.page == 0; clicked => { root.navigate(0); } }
            NavItem { glyph: "\u{E7FC}"; label: "Games"; compact: !root.pane-expanded; selected: root.page == 1; clicked => { root.navigate(1); } }
            NavItem { glyph: "\u{E81C}"; label: "History"; compact: !root.pane-expanded; selected: root.page == 2; clicked => { root.navigate(2); } }
            NavItem { glyph: "\u{E9D2}"; label: "Statistics"; compact: !root.pane-expanded; selected: root.page == 3; clicked => { root.navigate(3); } }
            Rectangle { }
            NavItem { glyph: "\u{E713}"; label: "Settings"; compact: !root.pane-expanded; selected: root.page == 4; clicked => { root.navigate(4); } }
        }
        // The page area sits on a slightly raised surface, like Windows 11 Settings.
        Rectangle {
            background: Theme.dark ? #272727 : #F9F9F9;
            border-top-left-radius: 8px;
            VerticalLayout {
                if root.connection-problem != "": Rectangle {
                    background: Theme.dark ? #433519 : #FFF4CE;
                    border-radius: 4px;
                    height: 56px;
                    accessible-role: text;
                    accessible-label: root.connection-problem;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Line { text: root.connection-problem; vertical-alignment: center; }
                        FluentButton {
                            text: "Start Playtime Tracker";
                            horizontal-stretch: 0;
                            clicked => { root.start-tracker(); }
                        }
                    }
                }
                if root.page == 0: OverviewPage {
                    title: root.overview-title;
                    one-game: root.overview-one-game;
                    tiles: root.overview-tiles;
                    live: root.overview-live;
                    bars: root.overview-bars;
                    games: root.overview-games;
                    sessions: root.overview-sessions;
                    sessions-header: root.overview-sessions-header;
                    show-more-text: root.overview-show-more-text;
                    empty: root.overview-empty;
                    all-games => { root.overview-all-games(); }
                    game-clicked(i) => { root.overview-game(i); }
                    live-clicked(i) => { root.overview-live-session(i); }
                    session-clicked(i) => { root.overview-session(i); }
                    day-clicked(i) => { root.overview-day(i); }
                    show-more => { root.overview-show-more(); }
                }
                if root.page != 0: Rectangle { }
            }
        }
    }
}
