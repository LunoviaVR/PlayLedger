// What the Rust side hands the pages: plain text, already formatted in the user's locale.

export struct Tile {
    caption: string,
    value: string,
    detail: string,
}

export struct SessionRow {
    game: string,
    day: string,
    range: string,
    duration: string,
    live: bool,
    accessible: string,
}

export struct GameRow {
    name: string,
    detail: string,
    total: string,
    live: bool,
    accessible: string,
}

export struct DayBar {
    // 0 to 1 of the chart's height.
    fraction: float,
    label: string,
    show-label: bool,
    tooltip: string,
    played: bool,
}

export struct RankRow {
    name: string,
    // 0 to 1 of the largest in the list.
    fraction: float,
    value: string,
    percent: string,
    accessible: string,
}

export struct HistoryDay {
    day: string,
    total: string,
    games: string,
    // 0 to 1 of the busiest day.
    fraction: float,
    played: bool,
    expanded: bool,
    sessions: [SessionRow],
    accessible: string,
}

export struct DetailRow {
    label: string,
    value: string,
}

export struct GameTile {
    name: string,
    // "12h 05m · 14 sessions · Sun, Sep 27".
    detail: string,
    // Shown when there's no artwork (yet).
    initial: string,
    live: bool,
    art: image,
    has-art: bool,
    // An exe icon: drawn small and centred, not stretched over the tile.
    art-is-icon: bool,
    accessible: string,
}

// An entry in one of the Settings lists (custom games, folders, ignored names).
export struct ListEntry {
    text: string,
    detail: string,
}
