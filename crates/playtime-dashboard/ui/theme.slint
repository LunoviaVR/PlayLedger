// Colours and type for the whole dashboard. Built-in Fluent widgets follow Windows' accent colour on their own,
// so everything that shows the user's accent setting (selection, switches, primary buttons, bars) uses Theme.accent.
import { Palette } from "std-widgets.slint";

export global Theme {
    // Set from the accent setting (for "windows", from Windows' own accent colour): a darker shade for light mode
    // and a lighter one for dark mode, as WinUI uses, so text on the accent stays readable.
    in-out property <color> accent-on-light: #005FB8;
    in-out property <color> accent-on-dark: #60CDFF;
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> accent: dark ? accent-on-dark : accent-on-light;
    out property <color> accent-text: dark ? #000000 : #FFFFFF;
    // AMOLED mode: in the dark theme the window and page are true black (an OLED screen turns those pixels off), and
    // cards and dialogs sit just above it, held apart by brighter borders. No effect in the light theme.
    in-out property <bool> amoled;
    out property <bool> black: dark && amoled;
    // Focus rings show only while the keyboard is in use, as in Windows: set when focus arrives by Tab, cleared by a
    // click.
    in-out property <bool> focus-visible;
    out property <brush> window: black ? #000000 : dark ? #202020 : #F3F3F3;
    out property <brush> layer: black ? #000000 : dark ? #272727 : #F9F9F9;
    out property <brush> card: black ? #0D0D0D : dark ? #2B2B2B : #FFFFFF;
    // Dialogs (and placeholder artwork in AMOLED mode): solid, a step above the cards.
    out property <brush> raised: black ? #161616 : dark ? #2B2B2B : #FFFFFF;
    out property <brush> card-border: black ? #FFFFFF24 : dark ? #FFFFFF14 : #0000000F;
    out property <brush> subtle: dark ? #FFFFFF0F : #0000000A;
    out property <brush> text: dark ? #FFFFFF : #000000E4;
    out property <brush> secondary-text: dark ? #FFFFFFC8 : #0000009E;
    out property <brush> tertiary-text: dark ? #FFFFFF8B : #00000072;
    out property <color> live: dark ? #6CCB5F : #0F7B0F;
    out property <length> radius: 8px;
    out property <length> gutter: 24px;
    // Segoe UI Variable, as Windows 11 uses; Windows falls back to Segoe UI where it's missing.
    out property <string> font: "Segoe UI Variable Text";
    out property <string> icons: "Segoe Fluent Icons";
}
